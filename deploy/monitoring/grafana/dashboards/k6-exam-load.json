{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Live k6 full-exam production load test. Requires the k6 run to use --out experimental-prometheus-rw against this Prometheus instance with K6_PROMETHEUS_RW_TREND_STATS=p(95),p(99),max,med. See Backend/scripts/load/README.md.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Concurrency k6 is currently driving. Should hold at the target profile value during the hold stage.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "min": 0, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "max(k6_vus)", "legendFormat": "active VUs" }],
      "title": "Active VUs",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Exams that have started and not yet submitted.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "min": 0, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "max(k6_exams_in_progress)", "legendFormat": "exams in progress" }],
      "title": "Exams In Progress",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Server-side request throughput observed by the API during the exam.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "min": 0, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "sum(rate(k6_http_reqs_total[1m]))", "legendFormat": "requests/sec" }],
      "title": "Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Fraction of requests returning a non-2xx status. Abort the run if this stays above 1%.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] } }, "max": 1, "min": 0, "unit": "percentunit" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "max(k6_http_req_failed_rate)", "legendFormat": "failed requests" }],
      "title": "Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Overall request latency percentiles as measured by k6. The backend only exports a rolling average, so k6 is the source of truth here.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 0, "lineWidth": 2 }, "min": 0, "unit": "ms" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "max(k6_http_req_duration_p95)", "legendFormat": "p95" },
        { "expr": "max(k6_http_req_duration_p99)", "legendFormat": "p99" },
        { "expr": "max(k6_http_req_duration_max)", "legendFormat": "max" },
        { "expr": "max(k6_http_req_duration_med)", "legendFormat": "median" }
      ],
      "title": "Request Latency (k6)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Latency of the three exam-critical write paths, p95 and p99.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 0, "lineWidth": 2 }, "min": 0, "unit": "ms" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "max(k6_answer_save_latency_p95)", "legendFormat": "answer p95" },
        { "expr": "max(k6_answer_save_latency_p99)", "legendFormat": "answer p99" },
        { "expr": "max(k6_heartbeat_latency_p95)", "legendFormat": "heartbeat p95" },
        { "expr": "max(k6_heartbeat_latency_p99)", "legendFormat": "heartbeat p99" },
        { "expr": "max(k6_exam_start_latency_p95)", "legendFormat": "start p95" },
        { "expr": "max(k6_exam_start_latency_p99)", "legendFormat": "start p99" }
      ],
      "title": "Exam Write Path Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Start / answer / submit success ratios. Any sustained dip below 1.0 indicates a functional failure, not just slowness.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.98 }, { "color": "green", "value": 0.999 }] } }, "max": 1, "min": 0, "unit": "percentunit" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "max(k6_exam_start_success_rate)", "legendFormat": "start" },
        { "expr": "max(k6_answer_success_rate)", "legendFormat": "answer" },
        { "expr": "max(k6_submit_success_rate)", "legendFormat": "submit" },
        { "expr": "max(k6_login_success_rate)", "legendFormat": "login" }
      ],
      "title": "Exam Flow Success Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Rate limiting from both sides: HTTP 429s seen by k6 and blocks recorded by the API. These should stay near zero. A rising k6 429 count usually means the per-user exam limiters are misconfigured for the load profile rather than genuine abuse.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "min": 0, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "sum(increase(k6_rate_limited_requests_total[1m]))", "legendFormat": "k6 429s/min" },
        { "expr": "sum(increase(lms_rate_limit_blocked_total[1m]))", "legendFormat": "API blocked/min" },
        { "expr": "max(lms_rate_limit_degraded)", "legendFormat": "limiter degraded" }
      ],
      "title": "Rate Limiting",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "k6-side failure counter broken down by API route and HTTP status. This is the first place to look when the run reports api_failures.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "min": 0, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 9,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "sum by (status) (increase(k6_api_failures_total[1m]))", "legendFormat": "failures: {{status}}" },
        { "expr": "sum by (route) (increase(k6_rate_limited_requests_total[1m]))", "legendFormat": "429 on {{route}}" }
      ],
      "title": "API Failures By Route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Backend view of the same run. api1 is the only worker replica, so report-job contention shows up on that target.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "min": 0, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 10,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "max(lms_api_error_rate_percent)", "legendFormat": "API 5xx %" },
        { "expr": "max by (instance) (lms_api_avg_response_ms)", "legendFormat": "avg ms {{instance}}" },
        { "expr": "max(lms_mongodb_up)", "legendFormat": "mongo up" },
        { "expr": "max(lms_redis_available)", "legendFormat": "redis available" }
      ],
      "title": "Backend Health During Run",
      "type": "timeseries"
    }
  ],
