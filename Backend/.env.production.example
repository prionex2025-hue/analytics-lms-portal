PORT=5000
NODE_ENV=production
RATE_LIMIT_DISABLED=false
REQUEST_BODY_LIMIT=5mb

MONGO_INITDB_ROOT_USERNAME=lms_root
MONGO_INITDB_ROOT_PASSWORD=change-this-mongo-root-password
MONGO_APP_USERNAME=lms_app
MONGO_APP_PASSWORD=change-this-mongo-app-password
MONGO_REPLICA_SET_NAME=rs0
MONGO_REPLICA_SET_HOST=mongo:27017
MONGO_REPLICA_SET_KEY=changethismongoreplicasetkeyAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
MONGODB_URI=mongodb://lms_app:change-this-mongo-app-password@mongo:27017/lms_portal?authSource=lms_portal&replicaSet=rs0
MONGODB_DB_NAME=lms_portal

REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:change-this-redis-password@redis:6379
REDIS_ENABLED=true
REDIS_QUEUE_ENABLED=true
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=noeviction
MONGO_MEMORY_LIMIT=4g
MONGO_CPU_LIMIT=2.0
REDIS_MEMORY_LIMIT=2g
REDIS_CPU_LIMIT=1.0
CLAMAV_MEMORY_LIMIT=2g
CLAMAV_CPU_LIMIT=1.0
# The API runs as 3 replicas (api1 = worker + web, api2/api3 = web-only).
# These limits are PER REPLICA. On an 8-vCPU host the CPU budget is roughly
# mongo 2 + redis 1 + clamav 1 + api 1.5*3 + frontend 0.5 (limits are ceilings,
# not reservations, so brief oversubscription is fine). Run monitoring on a
# separate host if you need more headroom.
API_MEMORY_LIMIT=2g
API_CPU_LIMIT=1.5
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5

METRICS_ENABLED=true
METRICS_TOKEN=thisisprionexprojectmetricsauthtoken
METRICS_TOKEN_FILE=./deploy/monitoring/secrets/metrics_token
PROMETHEUS_BIND_PORT=9090
GRAFANA_BIND_PORT=3000
ALERTMANAGER_BIND_PORT=9093
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
ALERTMANAGER_WEBHOOK_URL=

RESOURCE_UPLOAD_ROOT=/app/uploads/resources
RESOURCE_MAX_FILE_SIZE_BYTES=52428800
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@analyticsedify.com
RESEND_FROM_NAME="Analytics Edify"
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_DELIVERY_MODE=resend
PASSWORD_RESET_FRONTEND_BASE_URL=https://lms.analyticsedify.com
PASSWORD_RESET_FRONTEND_URL=https://lms.analyticsedify.com/reset-password
PASSWORD_RESET_ADMIN_FRONTEND_URL=https://lms.analyticsedify.com/admin/reset-password
PASSWORD_RESET_COLLEGE_ADMIN_FRONTEND_URL=https://lms.analyticsedify.com/college-admin/reset-password
PASSWORD_RESET_SUPER_ADMIN_FRONTEND_URL=https://lms.analyticsedify.com/super-admin/reset-password
PASSWORD_RESET_RETURN_TOKEN=false

FRONTEND_ORIGIN=https://lms.analyticsedify.com
FRONTEND_BIND_PORT=8080
APP_NETWORK_NAME=lms_portal_net

CLOUDINARY_CLOUD_NAME=dxiid7nwj
CLOUDINARY_URL=cloudinary://512315981517158:nzUNtjxOThhKcguxfOacJ_ERI28@dxiid7nwj
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lms-portal

BACKUP_ROOT=/var/backups/lms-portal
UPLOADS_BACKUP_ROOT=/var/backups/lms-portal/uploads
HOST_BACKUP_ROOT=/var/backups/lms-portal
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
# Configure one of these before production so backups leave the VPS.
BACKUP_RCLONE_DESTINATION=
BACKUP_RCLONE_FLAGS=
BACKUP_SYNC_VERIFY=true
BACKUP_SYNC_CONFIGURED=false
BACKUP_SYNC_COMMAND=

UPLOAD_DISK_WARNING_PERCENT=80
UPLOAD_DISK_CRITICAL_PERCENT=90
UPLOAD_TMP_MAX_AGE_HOURS=24
UPLOAD_AV_SCAN_ENABLED=true
UPLOAD_AV_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_STREAM_MAX_LENGTH=100M

RESPONSE_CACHE_ENABLED=true

